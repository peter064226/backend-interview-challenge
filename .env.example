# Backend Interview Challenge - Environment Variables
# Copy this file to .env and modify as needed

# Stage (local, dev, prod)
STAGE=local

# AWS Configuration (for LocalStack)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# EventBridge
EVENT_BUS_NAME=local.interview.eventbus

# SQS Queues
ORDER_QUEUE_NAME=local-order-processing-queue

# API Gateway
PORT=3000

# Debug mode
DEBUG=false
